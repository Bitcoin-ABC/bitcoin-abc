# alp-fusion coordinator environment
# Copy to .env and edit:  cp env.sample .env
#
# Start after build:
#   pnpm build && pnpm start:coordinator
# Dev (tsx, no rebuild):
#   pnpm dev:coordinator

# Chronik indexer URLs — comma-separated, tried in order with failover
CHRONIK_URLS=https://chronik.e.cash

# Bind address (all interfaces for a VPS lab: 0.0.0.0)
HOST=127.0.0.1

# Host clients dial for covert (FusionBegin). Defaults to HOST.
# Required when HOST is 0.0.0.0 or :: — must be a reachable hostname/IP.
# COVERT_DOMAIN=fusion.example

# Control / covert TCP ports
CONTROL_PORT=8788
COVERT_PORT=8789

# Players required to open a round (use 2 for lab; >=8 for public)
MIN_PLAYERS=8

# --- participant (separate process; ignored by the coordinator) ---
# pnpm build && pnpm start:participant
# pnpm dev:participant
# One attempt then exit: ONCE=1 or --once
#
# MNEMONIC="word1 word2 ... word12"
# TOKEN_ID=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# ATOM_TIER=0
# COORDINATOR_HOST=127.0.0.1
# ONCE=0
# CONTROL_PORT / CHRONIK_URLS / MIN_PLAYERS above are shared.
# MIN_PLAYERS must match the coordinator. MNEMONIC is 12 or 24 lowercase
# words separated by single spaces, at m/44'/1899'/0'/0/0. One ALP UTXO
# per round.
